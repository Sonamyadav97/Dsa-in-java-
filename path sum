/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if(root==null)return false;
        int s=0;
     return sum(root, 0,targetSum);
     
    }
    public boolean sum(TreeNode root, int s, int targetSum){
        if(root==null)return false;
        if(s+root.val==targetSum && root.left==null && root.right==null)return true;
      return  sum(root.left, s+root.val, targetSum) || sum(root.right, s+root.val, targetSum);
       
    }
}