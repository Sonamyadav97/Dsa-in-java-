class Solution {
    public boolean isHappy(int n) {
        
        HashSet <Integer> set=new HashSet<>();
        while (n!=1){
            if(set.contains(n)){
                return false;
            }
            
            set.add(n);
            int m=0;
            while(n>0){
             
                int q=n%10;
                m+=q*q;
                n=n/10;
            }
            n=m;
          }
        return true;
    }
}