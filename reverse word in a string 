class Solution {
    public String reverseWords(String s) {
        String reverse="";
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)== ' '){
                int j=i-1;
                while(j>=0 && s.charAt(j)!=' '){
                    reverse+=s.charAt(j);
                    j--;
                }
                reverse+=' ';
            }
        }
        for(int i=s.length()-1;i>=0 && s.charAt(i)!=' ';i--){
            reverse+=s.charAt(i);
        }
        
        return reverse;
    }
}