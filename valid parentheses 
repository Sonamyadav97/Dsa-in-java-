class Solution {
    public boolean isValid(String s) {
       Stack<Character> st= new Stack<>();
       boolean flag=false;
       int i=0;
       while(i<s.length()){
           if(s.charAt(i)=='(' || s.charAt(i)== '{' || s.charAt(i)=='['){
               st.push(s.charAt(i));
           }
          
       else{
           if(st.empty()) return false;
           if(s.charAt(i)==')' && st.peek()=='(' ){
               st.pop();
       }
      else if(s.charAt(i)=='}' && st.peek()=='{'){
               st.pop();
       }
       else if( s.charAt(i)==']' && st.peek()=='['){
               st.pop();
    }
    else return false;
   
}
i++;
}
return st.empty();
}
}