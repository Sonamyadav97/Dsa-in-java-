class Solution {
    public int romanToInt(String s) {
        int result=0;
        int num=0;
        int next=0;
        int value=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='I'){
                value=1;
            }
            else if(s.charAt(i)=='V'){
                value=5;
            }
            else if(s.charAt(i)=='X'){
                value=10;
            }
            else if(s.charAt(i)=='D'){
                value=500;
            }
            else if(s.charAt(i)=='C'){
                value=100;
            }
            else if(s.charAt(i)=='M'){
                value=1000;
            }
            else if(s.charAt(i)=='L'){
                value=50;
            }
            
           
            next=value;
            if(num>=next){
                result+=num;
                num=value;
            }
              else{
                  result-=num;
                  num=value;
            
            }
            
        }
        result+=num;
       return result; 
    }
}