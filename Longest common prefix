class Solution {
    public String longestCommonPrefix(String[] strs) {
        String so=strs[0];
        for(int i=1;i<strs.length;i++){
            int j=0;
            while(j<strs[i].length() && j<so.length() && strs[i].charAt(j)==so.charAt(j)){
                j++;
            }
            so= so.substring(0,j);
          if(so.equals("")){
              return "";
          }
           
        }
      return so;
      }
      }