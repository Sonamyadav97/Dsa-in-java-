class Solution {
    public void reverseString(char[] s) {
        char[] arr= new char[s.length];
        int j=0;
        int k=s.length-1;
        while(k>=0){
            arr[j]=s[k];
            j++;
            k--;
        }
        for(int i=0;i<s.length;i++){
            s[i]= arr[i];
        }
    }
}