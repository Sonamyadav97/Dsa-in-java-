class Solution {
    public int addDigits(int num) {
        int sum=0;
        while(num!=0){
            int q=num%10;
            num=num/10;
            sum=sum+q;
            if(num==0 && sum>=10){
                num=sum;
                sum=0;
            }
            else if(sum<10 && num==0){
                return sum;
            }
        }
        return sum;
        
    }
}