class Solution {
    void pushZerosToEnd(int[] arr) {
       int temp=0;
       int j =0;
        for(int i=0;i<arr.length;i++){
             if(arr[i]!=0){
                temp=arr[j];
                 arr[j]=arr[i];
                 arr[i]= temp;
                 j++;
             } 
            
                 
             
            }
        }
    }
