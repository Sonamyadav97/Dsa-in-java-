class Solution {
    public int lastStoneWeight(int[] stones) {
        PriorityQueue<Integer> pq= new PriorityQueue<>(Collections.reverseOrder());
        for(int x: stones){
            pq.add(x);
        }
        while(pq.size()>1){
            int top=pq.poll();
            int an=top-pq.poll();
            if(an>0){
            pq.add(an);
            }
        }
        int ans=0;
        if(!pq.isEmpty()){
            ans=pq.peek();
           }
     return ans;
    }
}