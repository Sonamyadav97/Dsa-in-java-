class Solution {
    public boolean backspaceCompare(String s, String t) {
        Stack<Character> sr= new Stack<>();
        Stack<Character> tr= new Stack<>();
      for (int i=0;i<s.length();i++){
           if(s.charAt(i)=='#'){
               if(!sr.empty()){
               sr.pop();
           }
           }
           else{
               sr.push(s.charAt(i));
           }
       }
       for (int i=0;i<t.length();i++){
           if(t.charAt(i)=='#'){
               if(!tr.empty()){
               tr.pop();
           }
           }
           else{
               tr.push(t.charAt(i));
           }
       }
       if(sr.size()!=tr.size()){
           return false;
           }
           
      while(!sr.empty()){
          if(sr.pop()!=tr.pop()){
              return false;
          }
      }
       return true;
        
    }
}