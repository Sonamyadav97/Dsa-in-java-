class Solution {
    public int getLucky(String s, int k) {
        String so="";
        for(int i=0;i<s.length();i++){
            int value=s.charAt(i)-96;
            so+=String.valueOf(value);
       }
        int q=0;
        for(int p=1;p<=k;p++){
            q=0;
            int j=0;
       while(j<so.length()){
           q+=so.charAt(j)-'0';
           j++;
       }
       so=String.valueOf(q);
       }
       return q;
       
    }
}