class Solution {
    static int nthFibonacci(int n) {
     int k = 0;
     int j=1;
     for(int i= 0;i<=n;i++){
         if(i==n){
             return k;
            
         }
         else {
             int p=k+j;
             k=j;
             j=p;
         }
     }
     return k;
        
    }
}
